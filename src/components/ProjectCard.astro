---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
	project: Project;
	sizes?: string;
	eager?: boolean;
}

const { project, sizes = '(max-width: 960px) 100vw, 34vw', eager = false } = Astro.props;
---

<a class="card" href={`/projects/${project.slug}/`} data-category={project.type} data-reveal>
	<div class="card__media">
		<Image
			src={project.cover}
			alt={`${project.title}, cover photo`}
			widths={[480, 720, 960, 1280]}
			sizes={sizes}
			loading={eager ? 'eager' : 'lazy'}
		/>
	</div>
	<div class="card__meta">
		<span class="card__name">{project.label} <span class="t-muted">— {project.location}</span></span>
	</div>
</a>
