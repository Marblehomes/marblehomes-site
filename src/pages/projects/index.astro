---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, types } from '../../data/projects';

const counts = Object.fromEntries(types.map((t) => [t, projects.filter((p) => p.type === t).length]));
---

<Base title="Projects" description="Custom houses, duplexes and apartment renovations built by Marble Homes across Sydney.">
	<section class="page-hero">
		<span class="eyebrow" data-reveal>Portfolio</span>
		<h1 class="display t-display" data-split="load">
			Our<br /><span class="t-muted">Projects</span><span class="dot">.</span>
		</h1>
		<div class="page-hero__intro prose" data-reveal>
			<p class="t-lead" style="color:var(--cream)">
				Custom houses, duplexes and apartment renovations across Sydney — built by Marble Homes on schedule, within budget and with clients
				involved at every stage.
			</p>
		</div>
	</section>

	<section class="wrap" style="padding-bottom:var(--section-y)">
		<div class="filters" role="toolbar" aria-label="Filter projects" data-filters>
			<button class="filter is-active" type="button" data-filter="all" aria-pressed="true">All<sup>{projects.length}</sup></button>
			{
				types.map((t) => (
					<button class="filter" type="button" data-filter={t} aria-pressed="false">
						{t}
						<sup>{counts[t]}</sup>
					</button>
				))
			}
		</div>
		<div class="project-grid" data-project-grid>
			{projects.map((p, i) => <ProjectCard project={p} sizes="(max-width: 960px) 100vw, 48vw" eager={i < 2} />)}
		</div>
	</section>
</Base>
